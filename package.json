{
  "name": "harness-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A teaching demo of OpenAI's Harness Engineering paradigm: SQL assistant CLI with explicit Intent/Plan/Check/Approve/Execute/Trace pipeline.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "harness": "./bin/harness"
  },
  "scripts": {
    "harness": "tsx src/cli/index.ts",
    "seed": "tsx src/cli/index.ts seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "openai": "^4.67.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.16.10",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
