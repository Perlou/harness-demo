{
  "name": "@your-scope/harness-demo",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "教学导向的 SQL 助手 CLI —— 把 OpenAI 在 2026/2 提出的 Harness Engineering 工程范式具象化为可运行代码。",
  "license": "MIT",
  "homepage": "https://github.com/your-scope/harness-demo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-scope/harness-demo.git"
  },
  "bugs": {
    "url": "https://github.com/your-scope/harness-demo/issues"
  },
  "keywords": [
    "harness-engineering",
    "openai",
    "agent",
    "ai",
    "llm",
    "sql",
    "cli",
    "policy",
    "approval-gate",
    "trace",
    "teaching",
    "demo"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "harness": "./bin/harness"
  },
  "files": [
    "bin",
    "src",
    "harness",
    "tsconfig.json",
    "README.md",
    "CONCEPT.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "harness": "tsx src/cli/index.ts",
    "seed": "tsx src/cli/index.ts seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm typecheck && pnpm test",
    "walkthrough": "bash scripts/demo-walkthrough.sh",
    "reset": "bash scripts/reset.sh",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "openai": "^4.67.0",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.16.10",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
