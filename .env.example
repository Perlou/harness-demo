# Harness execution mode: "demo" (default, deterministic) | "live" (calls OpenAI)
HARNESS_MODE=demo

# Required only when HARNESS_MODE=live
OPENAI_API_KEY=

# Where run artifacts are written
HARNESS_RUNS_DIR=./runs

# SQLite database path (created by `harness seed`)
HARNESS_DB_PATH=./data/demo.sqlite

# Scenario thresholds (rows)
HARNESS_ROW_BUDGET_READ=10000
HARNESS_ROW_BUDGET_WRITE=1000

# Live Mode model (only read when HARNESS_MODE=live)
HARNESS_LIVE_MODEL=gpt-4o-mini
